name="AppUI_ImagePanel"
num_shader_stages=2
renderview="App UI View"

stages
{
	"AppUI_ImagePanel.vert.spv", "vertex"
	"AppUI_ImagePanel.frag.spv", "fragment"
}

topology_type="triangle_list" 
enable_depth_testing="false"
enable_blending="true"

# Vertex attributes
attributes
{
	"position", "vec2"
	"texcoord", "vec2"
}

# Uniforms
uniforms
{
	"projection", 	"mat4", 		"frame" 
	"color",		"vec4", 		"material"
	"image",		"sampler",		"material" 
	"padding1",		"mat4", 		"material"	#FIXME: We shouldn't need to pad here, do it in the shader system or Vulkan renderer.
	"padding2",		"mat4", 		"material"
	"padding3",		"mat4", 		"material"
	"padding4",		"mat4", 		"material"
}
