name="Debug.Line.VertColor"
num_shader_stages=2
renderview="Debug View"

stages
{
	"Debug.Line.VertColor.vert.spv", "vertex"
	"Debug.Line.frag.spv", "fragment"
}

topology_type="line_list" 
enable_depth_testing="true"
enable_blending="true"

# Vertex attributes 
attributes
{
	"position", "vec3"
	"color", "vec4"
}

# Uniforms
uniforms
{
	"projection", 	"mat4", 			"frame" 
	"view", 		"mat4", 			"frame" 
	"model", 		"mat4", 			"draw" 
} 