name="Debug.Text"
num_shader_stages=2
renderview="Debug View"

stages
{
	"Debug.Text.vert.spv", "vertex"
	"Debug.Text.frag.spv", "fragment"
}

topology_type="triangle_list" 
enable_depth_testing="false"
enable_blending="true"

# Vertex attributes 
#DEBUGTODO: We don't need ALL of this for rendering 2d text in a 3d world, probably just need position and texcoord.
attributes
{
	"position", "vec3"
	"normal", "vec3"
	"texcoord", "vec2"
	"tangent", "vec3"
}

# Uniforms
uniforms
{
	"projection", 	"mat4", 			"frame" 
	"view", 		"mat4", 			"frame" 
	"color",		"vec4",				"material"
	"font_atlas",	"sampler",			"material"
	"dummy1",		"vec4",				"material"
	"dummy2",		"vec4",				"material" #TODO: Figure out how to handle uniform buffer alignment so that we don't have to do this padding in the shadercfg.
	"dummy3",		"vec4",				"material"
	"dummy4",		"vec4",				"material"
	"model", 		"mat4", 			"draw" 
} 