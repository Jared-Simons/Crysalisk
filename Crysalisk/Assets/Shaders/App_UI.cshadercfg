name="AppUI"
num_shader_stages=2
renderview="App UI View"

stages
{
	"AppUI.vert.spv", "vertex"
	"AppUI.frag.spv", "fragment"
}

topology_type="triangle_list" 
enable_depth_testing="false"
enable_blending="true"

# Vertex attributes
attributes
{
	"position", "vec2"
}

# Uniforms
uniforms
{
	"projection", 	"mat4", 		"frame" 
	"color",		"vec4", 		"material"
}
