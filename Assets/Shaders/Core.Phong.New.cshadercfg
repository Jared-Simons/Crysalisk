name="Core.Phong.New"
num_shader_stages=2

stages
{
	"core.vert.spv", "vertex"
	"core.frag.spv", "fragment"
}

topology_type="triangle_list"

# Vertex attributes 
attributes
{
	position,vec3
	texcoord,vec2
	normal,vec3
	tangent,vec3
}

# Vertex attributes
# attribute=Name,type
# NOTE: The order these are listed in must match the order they're declared in the vertex shader!
attribute=position,vec3
attribute=texcoord,vec2
attribute=normal,vec3
attribute=tangent,vec3

# Uniforms
# uniform=Name,Type,Descriptor Level
uniform=projection,mat4,0
uniform=view,mat4,0
uniform=viewPos,vec3,0
uniform=dirLightPos,vec3,0
uniform=renderMode,int,0
uniform=shininess,int,1
uniform=color,vec3,1
uniform=textures,texture[3],1
uniform=model,mat4,2